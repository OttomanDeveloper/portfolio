---
// src/components/sections/OssGrid.astro
import SectionLabel from '@/components/atoms/SectionLabel.astro';
import OssCard from '@/components/atoms/OssCard.astro';
import { openSource } from '@/data/openSource';
const mobileSelection = new Set(['firebase_admin_sdk', 'vision_ai', 'tanquery']);
---
<section id="opensource">
  <div class="container">
    <SectionLabel n={3} name="Open source" />
    <h2>Good tools deserve<br /><em>to be shared.</em></h2>
    <p class="intro">Thirteen packages on pub.dev — gap-fillers for the Flutter/Dart ecosystem. <span class="desktop-detail">Nine featured below.</span> Click any install snippet to copy.</p>
    <div class="grid">
      {openSource.map((p) => (
        <OssCard
          name={p.name}
          tagline={p.tagline}
          href={p.href}
          badge={p.badge}
          meta={p.meta}
          pubAdd={p.pubAdd}
          featured={p.featured}
          mobileHidden={!mobileSelection.has(p.name)}
        />
      ))}
    </div>
    <a class="mobile-packages-link" href="https://pub.dev/publishers/ottomancoder.com/packages" target="_blank" rel="noopener noreferrer">Explore all 13 packages <span aria-hidden="true">↗</span></a>
  </div>
</section>

<style>
  .mobile-packages-link { display:none; }
  @media(max-width:767px) {
    .desktop-detail { display:none; }
    .mobile-packages-link { display:flex; justify-content:space-between; align-items:center; min-height:48px; padding-block:.75rem; margin-top:1rem; font-size:.875rem; }
  }
  #opensource { padding-block: clamp(var(--s-8), 8vw, var(--s-10)); }
  h2 { font:700 clamp(2.5rem,4.5vw,4rem)/1.06 var(--font-display); letter-spacing:-.035em; margin-bottom:var(--s-5); }
  h2 em { color:var(--accent); font-weight:700; font-style:normal; }
  .intro { color: var(--fg-dim); max-inline-size: 60ch; margin: 0 0 var(--s-6); }
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  @media (min-width: 640px)  { .grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .grid { grid-template-columns: 1fr 1fr 1fr; } }
</style>
