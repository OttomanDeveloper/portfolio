---
import SectionLabel from '@/components/atoms/SectionLabel.astro';
import ProjectCover from '@/components/ProjectCover.astro';
import { showcaseProjects } from '@/data/showcase';
import { withBase } from '@/lib/paths';
interface Props { n?: number; viewAllHref?: string; viewAllCount?: number; }
const { n = 1, viewAllHref, viewAllCount } = Astro.props;
const order = ['legend-tv', 'lifelink', 'chronos', 'babypig', 'alcopass', 'udownload', 'icare'];
const featured = order.map(slug => showcaseProjects.find(p => p.slug === slug)!);
const caseSlugs = new Set(['legend-tv', 'lifelink', 'alcopass', 'udownload', 'icare']);
---
<section id="featured">
  <div class="container">
    <SectionLabel n={n} name="Selected projects" />
    <div class="section-heading"><h2>A few ideas,<br /><em>out in the world.</em></h2><p>Streaming, wellbeing, connected hardware, and a little curiosity. A selection of things I’ve designed, built, and shipped.</p></div>
    <div class="featured-grid">
      {featured.map((p, i) => (
        <article class:list={['feature', {marquee:i === 0}]}>
          <ProjectCover project={p} wide={i === 0} />
          <div class="project-meta"><span>{String(i+1).padStart(2,'0')} / {p.category}</span><span>{p.year}</span></div>
          <div class="project-info">
            <div><h3 style={p.slug === 'legend-tv' ? 'view-transition-name: case-title-legend-tv;' : undefined}>{p.name}</h3><p>{p.tagline}</p></div>
            <div class="project-actions">
              {caseSlugs.has(p.slug) && <a href={withBase('/projects/'+p.slug)}>The story <span aria-hidden="true">↗</span></a>}
              {p.liveLink && <a href={p.liveLink} target="_blank" rel="noopener noreferrer">Try it live <span aria-hidden="true">↗</span></a>}
              {p.githubLink && <a href={p.githubLink} target="_blank" rel="noopener noreferrer">Source code <span aria-hidden="true">↗</span></a>}
              {p.storeLink && <a href={p.storeLink} target="_blank" rel="noopener noreferrer">{/play\.google/.test(p.storeLink) ? 'Play Store' : 'Get app'} <span aria-hidden="true">↗</span></a>}
            </div>
          </div>
          {i === 0 && <p class="project-proof"><span>600K+ peak users</span><span>$20K+ year-one revenue</span><span>#1 in category for 5 months</span></p>}
        </article>
      ))}
    </div>
    <div class="all-work"><p>There’s more where these came from.</p><a href={viewAllHref ?? withBase('/projects')}>Explore all {viewAllCount ?? showcaseProjects.length} projects <span aria-hidden="true">↗</span></a></div>
  </div>
</section>
<style>
  #featured { padding-block:clamp(3rem,7vw,6rem); }
  .section-heading { display:grid; grid-template-columns:1.3fr 1fr; gap:3rem; align-items:end; margin-bottom:3rem; }
  h2 { font:600 clamp(2.5rem,4.5vw,4rem)/1.06 var(--font-display); letter-spacing:-.035em; }
  h2 em { color:var(--accent); font-weight:600; font-style:normal; }
  .section-heading > p { max-width:40ch; color:var(--fg-dim); font-size:1rem; line-height:1.75; padding-bottom:.3rem; }
  .featured-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:3.5rem 2rem; }
  .feature { min-width:0; }
  .marquee { grid-column:1/-1; }
  .feature :global(.project-cover) { border-radius:var(--r-featured); }
  .project-meta { display:flex; justify-content:space-between; gap:1rem; font:400 .65rem var(--font-mono); color:var(--fg-dim); margin-top:1.2rem; }
  .project-info { display:flex; justify-content:space-between; gap:1.3rem; margin-top:.55rem; }
  .project-info h3 { font:600 clamp(1.65rem,2.5vw,2.15rem)/1.2 var(--font-display); letter-spacing:-.04em; }
  .project-info p { font-size:.9375rem; line-height:1.7; color:var(--fg-dim); margin-top:.5rem; max-width:52ch; }
  .project-actions { display:flex; align-items:start; flex-direction:column; gap:.55rem; flex-shrink:0; padding-top:.5rem; font-size:.875rem; font-weight:500; }
  .project-actions a { display:flex; align-items:center; gap:1.3rem; border-bottom:1px solid var(--border); padding-block:.4rem; min-height:44px; }
  .project-actions a:hover { border-color:var(--accent); }
  .project-proof { display:flex; flex-wrap:wrap; gap:.8rem 2rem; margin-top:1rem; font-size:.7rem; color:var(--accent); }
  .project-proof span { padding-left:.75rem; border-left:1px solid var(--border); }
  .all-work { display:flex; justify-content:space-between; align-items:center; gap:1.5rem; margin-top:3rem; padding-top:1.5rem; border-top:1px solid var(--border); font-size:.8rem; }
  .all-work p { color:var(--fg-dim); }
  .all-work a { display:flex; align-items:center; gap:2rem; }
  @media(prefers-reduced-motion:no-preference) {
    .feature.reveal-ready :global(.product) { transform:translateY(20px); transition:transform .9s var(--ease-out); }
    .feature.is-revealed :global(.product) { transform:translateY(0); }
  }
  @media(max-width:767px) { .featured-grid > .feature:nth-child(n+3) { display:none; } }
  @media(max-width:767px) { .section-heading { grid-template-columns:1fr; gap:1rem; margin-bottom:2rem; } .featured-grid { grid-template-columns:1fr; gap:2.5rem; } .project-info { flex-direction:column; gap:.5rem; } .project-actions { flex-direction:row; gap:1rem; flex-wrap:wrap; } .all-work { align-items:start; flex-direction:column; } }
</style>
