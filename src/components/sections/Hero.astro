---
import { profile } from '@/data/profile';
import { withBase } from '@/lib/paths';
---
<section id="hero" aria-labelledby="hero-name">
  <div class="container">
    <div class="hero-topline"><span>Engineering with a human touch</span><span class="availability"><i aria-hidden="true"></i>{profile.available}</span></div>
    <div class="hero-layout">
      <div class="hero-copy">
        <p class="eyebrow">Hello, I’m Muhammad Usman.</p>
        <h1 id="hero-name"><span>Small screens.</span><br /><em>Big possibilities.</em></h1>
        <p class="hero-description">I build thoughtful mobile experiences that work in the real world. From the first sketch to the app store — Flutter, hardware, AI, and everything in between.</p>
        <div class="hero-actions">
          <a class="work-button" href="#featured">Explore my work <span aria-hidden="true">↗</span></a>
          <a class="text-link" href={withBase('/cv.pdf')} target="_blank" rel="noopener noreferrer">A little more about me <span aria-hidden="true">↗</span></a>
        </div>
        <div class="identity"><span class="identity-mark" aria-hidden="true">↗</span><p>{profile.tagline}<span>{profile.basedIn} · Working with clients worldwide</span></p></div>
      </div>
      <figure class="hero-art">
        <div class="portrait-frame">
          <img class="portrait" src={withBase('/profile.avif')} alt="Muhammad Usman, your mobile app engineer" width="480" height="480" fetchpriority="high" />
          <div class="portrait-signature"><span>{profile.name}</span><small>One engineer. From idea to launch.</small></div>
          <span class="portrait-seal"><strong>50+</strong><span>apps shipped</span></span>
        </div>
        <figcaption class="art-caption"><span>Meet the person behind the products.</span><span class="edition">Est. 2021 / Still building</span></figcaption>
      </figure>
    </div>
    <div class="hero-foot">
      <ul class="hero-stats" aria-label="Engineering in numbers">
        {profile.stats.map(s => <li><p>{s.num}<span>{s.unit}</span></p><small>{s.desc}</small></li>)}
      </ul>
      <a class="scroll-note" href="#featured">There’s a story behind every app <span aria-hidden="true">↓</span></a>
    </div>
  </div>
</section>

<style>
  #hero { padding-block:2rem 0; }
  .hero-topline { display:flex; justify-content:space-between; align-items:center; gap:1rem; color:var(--fg-dim); font-size:.73rem; padding-bottom:3.5rem; }
  .availability { display:flex; align-items:center; gap:.5rem; color:var(--accent); }
  .availability i { width:6px; height:6px; background:var(--accent); border-radius:50%; }
  .hero-layout { display:grid; grid-template-columns:1.2fr 1fr; gap:4rem; align-items:center; }
  .eyebrow { color:var(--fg-dim); font-size:.85rem; margin-bottom:1.4rem; }
  h1 { font:600 clamp(2.2rem,5vw,4.5rem)/1.1 var(--font-display); letter-spacing:-.045em; margin:0; }
  h1 em { color:var(--accent); font-weight:600; font-style:normal; }
  .hero-description { margin-top:1.9rem; max-width:42ch; font-size:1rem; line-height:1.8; color:var(--fg-dim); }
  .hero-actions { display:flex; align-items:center; flex-wrap:wrap; gap:1.5rem; margin-top:2rem; font-size:.875rem; font-weight:600; }
  .work-button { display:inline-flex; align-items:center; gap:2.3rem; padding:.9rem 1.2rem; background:var(--accent); color:var(--bg); border-radius:3px; transition:background .2s,transform .2s; min-height:44px; }
  .work-button:hover { background:var(--fg); color:var(--bg); transform:translateY(-2px); }
  .text-link { color:var(--fg); padding-block:.6rem; border-bottom:1px solid var(--border); }
  .text-link span { margin-left:.4rem; }
  .identity { display:flex; align-items:center; gap:.8rem; margin-top:2rem; }
  .identity-mark { display:grid; place-items:center; width:36px; height:36px; border:1px solid var(--border); color:var(--accent); flex-shrink:0; }
  .identity p { font-size:.85rem; font-weight:600; line-height:1.6; }
  .identity p span { display:block; color:var(--fg-dim); font-size:.75rem; font-weight:400; }
  .hero-art { min-width:0; margin:0; }
  .portrait-frame { position:relative; border-radius:6px; isolation:isolate; }
  .portrait { width:100%; height:auto; aspect-ratio:1; object-fit:cover; border-radius:6px; }
  .portrait-frame::after { content: ""; position:absolute; inset:45% 0 0; border-radius:0 0 6px 6px; background:linear-gradient(transparent,rgb(21 20 18 / .92)); pointer-events:none; }
  .portrait-signature { position:absolute; bottom:1.5rem; left:1.5rem; z-index:1; }
  .portrait-signature > span { display:block; font-size:1.2rem; font-weight:600; color:#fff5e5; }
  .portrait-signature small { display:block; font-size:.8rem; color:#e3dac8; margin-top:.3rem; }
  .portrait-seal { position:absolute; right:-1rem; top:1.5rem; padding:1rem 1.2rem; background:var(--accent); color:var(--bg); border-radius:3px; z-index:1; transform:rotate(4deg); }
  .portrait-seal strong { display:block; font-size:1.8rem; line-height:1.1; font-weight:600; }
  .portrait-seal span { font-size:.65rem; }
  .art-caption { display:flex; flex-wrap:wrap; justify-content:space-between; gap:.4rem; padding:.9rem 0; color:var(--fg-dim); font-size:.7rem; }
  .edition { font-family:var(--font-mono); font-size:.6rem; }
  .hero-foot { margin-top:4.5rem; border-top:1px solid var(--border); }
  .hero-stats { display:grid; grid-template-columns:repeat(4,1fr); list-style:none; padding:1.9rem 0; gap:2rem; border-bottom:1px solid var(--border); }
  .hero-stats li { border-right:1px solid var(--border); padding-right:1rem; }
  .hero-stats li:last-child { border:0; }
  .hero-stats p { font:400 clamp(2rem,3.5vw,3rem)/1 var(--font-display); letter-spacing:-.04em; font-variant-numeric:tabular-nums; }
  .hero-stats p span { font:400 .8rem var(--font-sans); color:var(--accent); margin-left:.15rem; }
  .hero-stats small { display:block; font-size:.7rem; color:var(--fg-dim); margin-top:.7rem; }
  .scroll-note { display:flex; justify-content:space-between; align-items:center; padding-block:1.2rem; font-size:.75rem; color:var(--fg-dim); }
  .scroll-note span { color:var(--accent); font-size:1.25rem; }
  @media(max-width:1023px) { .hero-layout { gap:2rem; } h1 { font-size:clamp(2.4rem,5vw,3.8rem); } .hero-actions { gap:1rem; } .portrait-seal { right:-.4rem; padding:.75rem; } }
  @media(max-width:767px) { #hero { padding-top:1.5rem; } .hero-layout { grid-template-columns:1fr; gap:0; } .hero-copy { display:contents; } .eyebrow { order:1; margin-bottom:1rem; } h1 { order:2; font-size:clamp(2.2rem,7.7vw,3.6rem); } .hero-art { order:3; width:min(100%,350px); margin:1.8rem auto 0; } .portrait { aspect-ratio:1.18; object-position:center 35%; } .hero-description { order:4; max-width:47ch; margin-top:1.2rem; font-size:1rem; } .hero-actions { order:5; margin-top:1.5rem; } .identity { order:6; margin-top:1.5rem; } .hero-topline { padding-bottom:2rem; flex-wrap:wrap; gap:.6rem; } .hero-foot { margin-top:2rem; } .hero-stats { grid-template-columns:repeat(2,minmax(0,1fr)); gap:1.5rem 1rem; } .hero-stats li:nth-child(2) { border:0; } .portrait-signature { left:1rem; bottom:1rem; } .portrait-signature > span { font-size:1rem; } .art-caption { font-size:.65rem; } .edition { display:none; } .scroll-note { gap:1rem; line-height:1.6; } }
  @media(max-width:399px) { h1 { font-size:clamp(1.95rem,9.2vw,2.3rem); } .hero-actions { align-items:start; } .portrait-signature small { font-size:.7rem; } }
  @media(prefers-reduced-motion:no-preference) {
    h1 > span { display:inline-block; animation:headline-arrive .8s cubic-bezier(.2,.8,.2,1) both; }
    h1 em { display:inline-block; animation:headline-arrive .8s .12s cubic-bezier(.2,.8,.2,1) both; }
    .hero-art { animation:portrait-arrive 1s .15s cubic-bezier(.2,.8,.2,1) both; }
    .portrait-seal { animation:seal-arrive .65s .65s cubic-bezier(.2,.8,.2,1) both; }
  }
  @keyframes headline-arrive { from { opacity:0; transform:translateY(18px); } to { opacity:1; transform:translateY(0); } }
  @keyframes portrait-arrive { from { opacity:0; transform:translateY(24px) rotate(2deg); } to { opacity:1; transform:translateY(0) rotate(0); } }
  @keyframes seal-arrive { from { opacity:0; transform:translateY(8px) rotate(0); } to { opacity:1; transform:translateY(0) rotate(4deg); } }
</style>
