---
// src/components/sections/Hero.astro
import StatusPill from '@/components/atoms/StatusPill.astro';
import StatsRow from '@/components/atoms/StatsRow.astro';
import { profile } from '@/data/profile';

const techChips = ['Flutter', 'Dart', 'BLE', 'Gemini AI', 'Firebase', 'Isolates'];
const reach = [
  { label: 'YouTube',  value: '140K+', href: 'https://www.youtube.com/@OttomanCoder' },
  { label: 'LinkedIn', value: '60K+',  href: 'https://www.linkedin.com/in/ottomancoder/' },
  { label: 'Twitter',  value: '41K+',  href: 'https://twitter.com/ottomancoder' },
  { label: 'GitHub',   value: '10K+',  href: 'https://github.com/OttomanDeveloper' },
];
---
<section id="hero" aria-labelledby="hero-name">
  <div class="bg-grid" aria-hidden="true"></div>
  <div class="bg-glow" aria-hidden="true"></div>

  <div class="container row">
    <div class="copy">
      <p class="eyebrow" aria-hidden="true">
        <span class="dot"></span>
        <span>▸ TODAY</span>
        <span class="sep">·</span>
        <span class="live"><span id="ist-clock">IST</span></span>
        <span class="sep">·</span>
        <span class="tone-accent">BUILDING NMO AI</span>
      </p>

      <h1 id="hero-name" class="wordmark">{profile.name}<span class="dot-period">.</span></h1>
      <p class="alias">{profile.alias} · {profile.tagline}</p>

      <ul class="techchips" aria-hidden="true">
        {techChips.map((t) => <li>{t}</li>)}
      </ul>

      <p class="tagline">{profile.taglineLong}</p>

      <div class="pill-row">
        <StatusPill label={profile.available} />
      </div>

      <div class="stats">
        <StatsRow stats={[...profile.stats]} compact />
      </div>

      <a class="scroll" href="#legend-tv" aria-label="scroll to next section">
        <span>scroll to explore</span>
        <span class="arrow" aria-hidden="true">↓</span>
      </a>
    </div>

    <aside class="side" aria-label="Portrait and current focus">
      <div class="portrait-wrap">
        <img class="portrait" src="/profile.avif" alt={profile.name} width="280" height="280" loading="eager" fetchpriority="high" />
        <span class="arabic" lang="ar" dir="rtl">{profile.aliasArabic}</span>
      </div>

      <article class="reach" aria-label="Reach across platforms">
        <p class="reach-eyebrow" aria-hidden="true">▸ REACH</p>
        <ul>
          {reach.map((r) => (
            <li>
              <a href={r.href} target="_blank" rel="noopener noreferrer">
                <span class="r-value">{r.value}</span>
                <span class="r-label">{r.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </article>

      <article class="now">
        <p class="now-eyebrow" aria-hidden="true">▸ CURRENTLY SHIPPING</p>
        <p class="now-title">{profile.currentlyShipping.text}</p>
        <p class="now-where">
          at <a href={profile.currentlyShipping.href} target="_blank" rel="noopener noreferrer">{profile.currentlyShipping.at}</a>
        </p>
        <ul class="now-tags" aria-hidden="true">
          <li>BLE</li>
          <li>Gemini AI</li>
          <li>Flutter</li>
          <li>MENA</li>
        </ul>
      </article>

      <p class="based">
        <span class="based-k">based</span>
        <span class="based-v">{profile.basedIn}</span>
        <span class="based-note">{profile.basedNote}</span>
      </p>
    </aside>
  </div>

  <p class="divider" aria-hidden="true">// ─────────── <span>01 · FEATURED PROJECT</span> ───────────</p>
</section>

<script>
  // Live IST clock (Asia/Karachi)
  function tickClock() {
    const el = document.getElementById('ist-clock');
    if (!el) return;
    try {
      const time = new Intl.DateTimeFormat('en-GB', {
        hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Karachi',
      }).format(new Date());
      el.textContent = `IST ${time}`;
    } catch {
      el.textContent = 'IST';
    }
  }
  tickClock();
  setInterval(tickClock, 60_000);
</script>

<style>
  #hero {
    position: relative;
    min-block-size: 100svh;
    padding-block: var(--s-9);
    isolation: isolate;
    overflow: hidden;
  }

  /* Background flair */
  .bg-grid {
    position: absolute; inset: 0; z-index: -2;
    background-image:
      linear-gradient(to right, oklch(100% 0 0 / 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, oklch(100% 0 0 / 0.03) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000 0%, transparent 90%);
  }
  .bg-glow {
    position: absolute; inset: 0; z-index: -1;
    background: radial-gradient(50% 50% at 75% 35%, var(--accent-glow), transparent 60%);
    opacity: 0.55;
    pointer-events: none;
  }
  @media (max-width: 1023px) { .bg-glow { background-position: 80% 8%; } }

  .row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-8);
    align-items: start;
    position: relative;
  }
  @media (min-width: 1024px) {
    .row { grid-template-columns: 1.3fr 1fr; align-items: center; }
  }

  /* LEFT */
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--fg-dim);
    font: 400 var(--fs-micro) var(--font-mono);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-block-end: var(--s-4);
    padding: var(--s-2) var(--s-3);
    background: oklch(15% 0.02 80 / 0.5);
    border: 1px solid var(--border-soft);
    border-radius: var(--r-pill);
    backdrop-filter: blur(8px);
  }
  .eyebrow .sep { color: var(--fg-dim); opacity: 0.5; }
  .eyebrow .tone-accent { color: var(--accent); }
  .eyebrow .dot {
    inline-size: 7px; block-size: 7px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    animation: pulse-dot 2s ease-in-out infinite;
  }
  @keyframes pulse-dot { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
  @media (prefers-reduced-motion: reduce) { .eyebrow .dot { animation: none; } }

  .wordmark {
    color: var(--fg);
    font: 700 var(--fs-hero) / var(--lh-tight) var(--font-mono);
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }
  .dot-period {
    color: var(--accent);
    animation: dot-blink 1.6s steps(2) infinite;
  }
  @keyframes dot-blink { 50% { opacity: 0.35; } }
  @media (prefers-reduced-motion: reduce) { .dot-period { animation: none; } }

  .alias {
    color: var(--accent);
    font: 600 var(--fs-body) var(--font-sans);
    margin: var(--s-4) 0 var(--s-3);
  }

  .techchips {
    list-style: none; padding: 0;
    margin: 0 0 var(--s-5);
    display: flex; flex-wrap: wrap; gap: var(--s-2);
  }
  .techchips li {
    padding: 3px 10px;
    color: var(--fg);
    background: color-mix(in oklab, var(--fg) 5%, transparent);
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    font: 400 var(--fs-micro) var(--font-mono);
    letter-spacing: 0.06em;
  }

  .tagline {
    color: var(--fg-dim);
    font: 400 var(--fs-body) var(--font-sans);
    max-inline-size: 52ch;
    margin: 0;
  }
  .pill-row { margin: var(--s-6) 0; }
  .stats { margin-block: var(--s-7) var(--s-5); }
  .scroll {
    display: inline-flex; align-items: center; gap: var(--s-2);
    color: var(--fg-dim);
    font: 400 var(--fs-micro) var(--font-mono);
    letter-spacing: 0.18em; text-transform: uppercase;
    margin-block-start: var(--s-7);
    text-decoration: none;
    padding-block: var(--s-2);
    min-block-size: 44px;
    transition: color var(--t-base) var(--ease-out);
    width: max-content;
  }
  .scroll:hover, .scroll:focus-visible { color: var(--accent); }
  .scroll .arrow {
    display: inline-block;
    animation: hero-bounce 1.6s ease-in-out infinite;
  }
  .scroll:hover .arrow, .scroll:focus-visible .arrow { animation-duration: 0.9s; }
  @keyframes hero-bounce {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(5px); }
  }
  @media (prefers-reduced-motion: reduce) { .scroll .arrow { animation: none; } }

  /* RIGHT */
  .side {
    display: grid;
    gap: var(--s-5);
    align-self: stretch;
    align-content: center;
  }

  .portrait-wrap {
    position: relative;
    justify-self: center;
    inline-size: clamp(180px, 28vw, 280px);
  }
  .portrait {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--accent);
    box-shadow:
      0 0 0 6px var(--bg-elev),
      0 0 0 7px var(--border-soft),
      0 0 60px -4px var(--accent-glow),
      0 24px 48px -16px oklch(20% 0.02 80 / 0.55);
  }
  .arabic {
    position: absolute;
    inset-block-start: -8px;
    inset-inline-end: -16px;
    color: var(--accent);
    font: 700 var(--fs-arabic) / 1 var(--font-arabic);
    pointer-events: none;
    background: var(--bg);
    padding: 0 var(--s-2);
    border-radius: var(--r-pill);
  }

  /* Reach widget */
  .reach {
    padding: var(--s-4) var(--s-5);
    background: var(--bg-elev);
    border: 1px solid var(--border-soft);
    border-radius: var(--r-card);
  }
  .reach-eyebrow {
    color: var(--accent);
    font: 400 var(--fs-micro) var(--font-mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 var(--s-3);
  }
  .reach ul {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-3);
  }
  .reach a {
    display: grid;
    gap: 2px;
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--border);
    border-radius: var(--r-pkg);
    color: var(--fg);
    text-decoration: none;
    transition: border-color var(--t-base) var(--ease-out), color var(--t-base) var(--ease-out);
    min-block-size: 56px;
  }
  .reach a:hover { border-color: var(--accent); color: var(--fg); }
  .r-value { font: 700 var(--fs-body) var(--font-mono); color: var(--fg); }
  .r-label { font: 400 var(--fs-micro) var(--font-mono); color: var(--fg-dim); letter-spacing: 0.12em; text-transform: uppercase; }
  .reach a:hover .r-value { color: var(--accent); }

  .now {
    padding: var(--s-5);
    background: var(--bg-elev);
    border: 1px solid var(--border-soft);
    border-radius: var(--r-card);
  }
  .now-eyebrow {
    color: var(--accent);
    font: 400 var(--fs-micro) var(--font-mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 var(--s-3);
  }
  .now-title { color: var(--fg); font: 700 var(--fs-h3) var(--font-sans); margin: 0 0 var(--s-2); }
  .now-where { color: var(--fg-dim); font: 400 var(--fs-small) var(--font-sans); margin: 0 0 var(--s-4); }
  .now-where a { color: var(--accent); text-decoration: none; border-bottom: 1px solid color-mix(in oklab, var(--accent) 35%, transparent); }
  .now-where a:hover { border-bottom-color: var(--accent); color: var(--fg); }
  .now-tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .now-tags li {
    padding: 3px 9px;
    color: var(--fg);
    background: color-mix(in oklab, var(--fg) 5%, transparent);
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    font: 400 var(--fs-micro) var(--font-mono);
    letter-spacing: 0.04em;
  }

  .based {
    display: flex; flex-wrap: wrap; gap: var(--s-2);
    align-items: baseline;
    margin: 0;
    color: var(--fg-dim);
    font: 400 var(--fs-small) var(--font-sans);
  }
  .based-k { color: var(--accent); font: 400 var(--fs-micro) var(--font-mono); letter-spacing: 0.18em; text-transform: uppercase; }
  .based-v { color: var(--fg); font-weight: 600; }
  .based-note { color: var(--fg-dim); }

  /* Section divider */
  .divider {
    margin: var(--s-9) auto 0;
    text-align: center;
    color: var(--fg-dim);
    font: 400 var(--fs-micro) var(--font-mono);
    letter-spacing: 0.18em;
    opacity: 0.6;
  }
  .divider span { color: var(--accent); }

  @media (max-width: 639px) {
    .arabic { font-size: clamp(1.5rem, 1.5vw + 0.5rem, 2rem); inset-inline-end: -8px; }
    .reach ul { grid-template-columns: 1fr 1fr; }
    .eyebrow { flex-wrap: wrap; }
  }
</style>
