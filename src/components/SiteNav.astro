---
import { withBase } from '@/lib/paths';
import { profile } from '@/data/profile';
const isProjects = Astro.url.pathname.includes('/projects');
---
<header class="site-nav">
  <nav class="container nav-inner" aria-label="Main navigation">
    <a class="brand" href={withBase('/')} aria-label={`${profile.name} — home`}>
      <span class="monogram" aria-hidden="true">u.</span>
      <span>{profile.alias}<small>Independent mobile engineer</small></span>
    </a>
    <div class="nav-links">
      <a href={withBase('/projects')} aria-current={isProjects ? 'page' : undefined}>Work</a>
      <a href={withBase('/#opensource')}>Open source</a>
      <a href={withBase('/#experience')}>About</a>
      <a class="nav-contact" href={withBase('/#contact')}>Let’s talk <span aria-hidden="true">↗</span></a>
    </div>
  </nav>
</header>
<style>
  .site-nav { background:var(--bg-elev); border-bottom:1px solid rgb(201 166 91 / .45); box-shadow:0 6px 24px rgb(0 0 0 / .16); }
  .nav-inner { display:flex; justify-content:space-between; align-items:center; gap:2rem; padding-block:1.4rem; }
  .brand { display:flex; gap: .85rem; align-items:center; color:var(--fg); font-family:var(--font-display); font-size:1.1rem; font-weight:600; line-height:1.4; }
  .monogram { font:italic 3rem/.9 var(--font-brand); letter-spacing:-.1em; padding-right:.25rem; color:var(--accent); }
  .brand small { display:block; font-family:var(--font-sans); font-size:.75rem; color:var(--fg-dim); font-weight:400; }
  .nav-links { display:flex; align-items:center; gap:2rem; font-size:1rem; font-weight:600; }
  .nav-links a { color:var(--fg); transition:color .2s; min-height:44px; display:flex; align-items:center; white-space:nowrap; }
  .nav-links a:hover, .nav-links a[aria-current] { color:var(--accent); text-decoration:underline; text-underline-offset:5px; }
  .nav-links .nav-contact { display:flex; gap:1.5rem; border:1px solid var(--accent); background:var(--accent); color:var(--bg); padding:.75rem 1.2rem; border-radius:3px; transition:background .2s,border-color .2s; }
  .nav-links .nav-contact:hover { background:var(--fg); border-color:var(--fg); color:var(--bg); text-decoration:none; }
  .nav-links a:focus-visible { outline:2px solid var(--accent); outline-offset:5px; }
  @media(max-width:639px) { .nav-inner { padding-block:1.1rem; gap:.7rem; } .brand small { display:none; } .nav-links { gap:.8rem; font-size:.875rem; } .nav-links > a:nth-child(2), .nav-links > a:nth-child(3) { display:none; } .nav-links .nav-contact { padding:.55rem .8rem; gap:.6rem; } .brand { font-size:.8rem; white-space:nowrap; gap:.65rem; } .monogram { font-size:2.5rem; } }
</style>
