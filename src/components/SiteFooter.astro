---
import { profile } from '@/data/profile';
import { withBase } from '@/lib/paths';
---
<footer class="site-footer">
  <div class="container footer-inner">
    <p>{profile.name}<span>Crafted with care, in Islamabad.</span></p>
    <div><a href="https://github.com/OttomanDeveloper" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={withBase('/cv.pdf')} target="_blank" rel="noopener noreferrer">Résumé ↗</a><a href="#main">Back to top ↑</a></div>
  </div>
</footer>
<style>
  .site-footer { border-top:1px solid var(--border); padding-block:2rem; }
  .footer-inner { display:flex; align-items:center; justify-content:space-between; gap:2rem; font-size:.75rem; color:var(--fg-dim); }
  p { color:var(--fg); font-weight:600; } p span { display:block; color:var(--fg-dim); font-weight:400; margin-top:.25rem; }
  .footer-inner div { display:flex; flex-wrap:wrap; gap:1.5rem; }
  @media(max-width:639px) { .footer-inner { align-items:start; flex-direction:column; } }
</style>
