---
// src/components/atoms/SectionLabel.astro
interface Props { eyebrow?: string; n?: number; name: string; }
const { n, name } = Astro.props;
---
<p class="label" aria-hidden="true"><span>{n != null ? String(n).padStart(2, '0') : '↗'}</span>{name}</p>

<style>
  .label {
    color: var(--accent);
    display:flex; align-items:center; gap:.8rem;
    font: 500 .8rem var(--font-sans);
    letter-spacing: .01em;
    margin-block-end: var(--s-5);
  }
  .label span { font:400 .68rem var(--font-mono); color:var(--fg-dim); border:1px solid var(--border); padding:.2rem .4rem; }
</style>
