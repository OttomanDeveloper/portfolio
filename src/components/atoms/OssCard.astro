---
// src/components/atoms/OssCard.astro
interface Props {
  name: string;
  tagline: string;
  href: string;
  badge?: { label: string; tone?: 'gold' | 'cyan' | 'lime' | 'dim' };
  meta?: string;
  pubAdd?: string;
  featured?: boolean;
  mobileHidden?: boolean;
}
const { name, tagline, href, badge, meta, pubAdd, featured = false, mobileHidden = false } = Astro.props;
---
<article class:list={['oss', featured && 'featured', mobileHidden && 'mobile-hidden']}>
  {featured && <span class="ribbon" aria-hidden="true">★ G</span>}

  <a class="head" href={href} target="_blank" rel="noopener noreferrer">
    {badge && <p class={`badge tone-${badge.tone ?? 'gold'}`}>{badge.label}</p>}
    <h3 class="name">{name}</h3>
    <p class="tagline">{tagline}</p>
  </a>

  {pubAdd && (
    <button
      class="snippet"
      type="button"
      data-copy={pubAdd}
      aria-label={`copy install command: ${pubAdd}`}
    >
      <span class="prompt" aria-hidden="true">$</span>
      <span class="cmd">{pubAdd}</span>
      <span class="copy-hint" aria-hidden="true">copy</span>
    </button>
  )}

  <div class="foot">
    <a class="link" href={href} target="_blank" rel="noopener noreferrer">pub.dev →</a>
    {meta && <span class="meta">{meta}</span>}
  </div>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>('.oss .snippet[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const txt = btn.dataset.copy;
      if (!txt) return;
      try {
        await navigator.clipboard.writeText(txt);
        const hint = btn.querySelector('.copy-hint');
        if (hint) {
          const orig = hint.textContent ?? 'copy';
          hint.textContent = '✓ copied';
          btn.classList.add('copied');
          setTimeout(() => {
            if (hint) hint.textContent = orig;
            btn.classList.remove('copied');
          }, 1800);
        }
      } catch { /* clipboard denied — no-op */ }
    });
  });
</script>

<style>
  @media(max-width:767px) { .oss.mobile-hidden { display:none; } }
  .oss { position:relative; display:flex; flex-direction:column; gap:1rem; padding:1.7rem; border:1px solid var(--border); background:transparent; transition:background .2s; }
  .oss:hover { background:var(--bg-elev); }
  .featured { background:var(--bg-elev); }
  .ribbon { position:absolute; right:1rem; top:1rem; color:var(--accent); font-size:.7rem; }
  .head { color:inherit; text-decoration:none; }
  .badge { color:var(--accent); font:600 .7rem/1.5 var(--font-sans); letter-spacing:.04em; padding-right:1.5rem; margin-bottom:.7rem; }
  .name { font:600 1.0625rem/1.4 var(--font-sans); color:var(--fg); margin-bottom:.65rem; overflow-wrap:anywhere; }
  .head:hover .name { color:var(--accent); }
  .tagline { font-size:.9375rem; color:var(--fg-dim); line-height:1.7; }
  .snippet { display:grid; grid-template-columns:auto 1fr auto; align-items:center; gap:.5rem; padding:.65rem; min-height:44px; background:var(--bg); color:var(--fg); border:1px solid var(--border); border-radius:3px; cursor:pointer; text-align:start; font:400 .68rem/1.5 var(--font-mono); margin-top:auto; }
  .snippet:hover { border-color:var(--accent); }
  .prompt { color:var(--accent); }
  .cmd { overflow-wrap:anywhere; }
  .copy-hint { color:var(--fg-dim); font:400 .6rem var(--font-sans); }
  .copied .copy-hint { color:var(--accent); }
  .foot { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:.5rem; font-size:.65rem; }
  .meta { color:var(--fg-dim); }
  .link { color:var(--accent); }
  .link:hover { text-decoration:underline; text-underline-offset:3px; }
  @media(max-width:639px) { .oss { padding:1.3rem; } }
</style>
