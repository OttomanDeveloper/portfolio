---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import FeaturedProjects from '@/components/sections/FeaturedProjects.astro';
import { withBase } from '@/lib/paths';
import { showcaseProjects } from '@/data/showcase';
import SelectedWork from '@/components/sections/SelectedWork.astro';
import OssGrid from '@/components/sections/OssGrid.astro';
import ExperienceTimeline from '@/components/sections/ExperienceTimeline.astro';
import StackGrid from '@/components/sections/StackGrid.astro';
import HireMe from '@/components/sections/HireMe.astro';
import { profile } from '@/data/profile';

// Mirror BaseLayout's source of truth: Astro.site (PUBLIC_SITE_URL → Vercel
// prod domain → localhost), trailing slash stripped for clean JSON-LD URLs.
const siteUrl = (Astro.site ?? new URL('http://localhost:4321')).href.replace(/\/$/, '');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteUrl}/#muhammad-usman`,
  name: 'Muhammad Usman',
  alternateName: ['Ottoman Coder', 'OttomanDeveloper'],
  jobTitle: 'Senior Flutter / Mobile Engineer',
  description: 'Flutter/mobile founder-builder based in Islamabad, Pakistan, shipping production iOS and Android apps under the Ottoman Coder brand.',
  url: siteUrl,
  image: `${siteUrl}/og/default.png`,
  email: 'mailto:ottomandeveloper@gmail.com',
  telephone: '+92 317 7794553',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Islamabad',
    addressCountry: 'PK',
  },
  knowsAbout: [
    'Flutter', 'Dart', 'iOS', 'Android',
    'Mobile application development', 'Firebase',
    'Bluetooth Low Energy', 'Google Gemini', 'App Store', 'Google Play',
  ],
  sameAs: [
    'https://github.com/OttomanDeveloper',
    'https://www.linkedin.com/in/ottomancoder',
    'https://x.com/ottomancoder',
    'https://ottomancoder.medium.com',
    'https://www.malt.fr/profile/muhammadusman4',
    'https://www.youtube.com/@OttomanCoder',
    'https://stackoverflow.com/users/15117215',
    'https://pub.dev/publishers/ottomancoder.com/packages',
    siteUrl,
  ],
};
---
<BaseLayout
  title={`Ottoman Coder — Muhammad Usman | ${profile.tagline}`}
  description={`Muhammad Usman (Ottoman Coder). ${profile.tagline}. ${profile.basedIn}. Flutter/mobile founder-builder shipping production iOS and Android apps.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Hero />
  <FeaturedProjects />
  <SelectedWork n={4} label="more projects" limit={8} viewAllHref={withBase('/projects')} viewAllCount={showcaseProjects.length} />
  <OssGrid />
  <ExperienceTimeline />
  <StackGrid />
  <HireMe />
</BaseLayout>
