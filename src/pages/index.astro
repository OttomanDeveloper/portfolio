---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import GoogleStory from '@/components/sections/GoogleStory.astro';
import FeaturedLegendTV from '@/components/sections/FeaturedLegendTV.astro';
import WebDemos from '@/components/sections/WebDemos.astro';
import ProjectsGrid from '@/components/sections/ProjectsGrid.astro';
import OssGrid from '@/components/sections/OssGrid.astro';
import ExperienceTimeline from '@/components/sections/ExperienceTimeline.astro';
import StackGrid from '@/components/sections/StackGrid.astro';
import StatusSection from '@/components/sections/StatusSection.astro';
import Contact from '@/components/sections/Contact.astro';
import { profile } from '@/data/profile';
---
<BaseLayout
  title={`${profile.name} — ${profile.tagline}`}
  description={`${profile.alias}. ${profile.tagline}. ${profile.basedIn}. 50+ apps shipped. 9 open-source packages.`}
>
  <Hero />
  <GoogleStory />
  <FeaturedLegendTV />
  <WebDemos />
  <ProjectsGrid />
  <OssGrid />
  <ExperienceTimeline />
  <StackGrid />
  <StatusSection />
  <Contact />
</BaseLayout>
