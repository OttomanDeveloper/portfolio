---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import JourneyTrail from '@/components/JourneyTrail.astro';
import Approach from '@/components/sections/Approach.astro';
import FeaturedProjects from '@/components/sections/FeaturedProjects.astro';
import { withBase } from '@/lib/paths';
import { showcaseProjects } from '@/data/showcase';
import SelectedWork from '@/components/sections/SelectedWork.astro';
import OssGrid from '@/components/sections/OssGrid.astro';
import ExperienceTimeline from '@/components/sections/ExperienceTimeline.astro';
import StackGrid from '@/components/sections/StackGrid.astro';
import HireMe from '@/components/sections/HireMe.astro';
import { profile } from '@/data/profile';

// Mirror BaseLayout's source of truth: Astro.site (PUBLIC_SITE_URL → Vercel
// prod domain → localhost), trailing slash stripped for clean JSON-LD URLs.
const siteUrl = (Astro.site ?? new URL('http://localhost:4321')).href.replace(/\/$/, '');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: ['Ottoman Coder', 'OttomanDeveloper'],
  jobTitle: 'Senior Flutter / Mobile Engineer',
  description: 'Senior Flutter engineer in Islamabad who ships production iOS and Android apps end-to-end. Founder-builder under Ottoman Coder; fullstack-capable with general backend literacy.',
  url: siteUrl,
  image: `${siteUrl}/profile.avif`,
  email: `mailto:${profile.email}`,
  telephone: '+92-317-7794553',
  address: { '@type': 'PostalAddress', addressLocality: 'Islamabad', addressCountry: 'PK' },
  knowsAbout: [
    'Flutter',
    'Dart',
    'iOS',
    'Android',
    'Mobile application development',
    'Firebase',
    'Supabase',
    'Bluetooth Low Energy',
    'On-device machine learning',
    'Google Gemini',
    'App Store',
    'Google Play'
  ],
  sameAs: [
    'https://github.com/OttomanDeveloper',
    'https://www.linkedin.com/in/ottomancoder',
    'https://x.com/ottomancoder',
    'https://ottomancoder.medium.com',
    'https://www.malt.fr/profile/muhammadusman4',
    'https://www.youtube.com/@OttomanCoder',
    'https://stackoverflow.com/users/15117215',
    'https://pub.dev/publishers/ottomancoder.com/packages'
  ],
};
---
<BaseLayout
  title={`${profile.name} — Senior Flutter Engineer · ${profile.alias}`}
  description="Muhammad Usman (Ottoman Coder) — Senior Flutter engineer, Islamabad. Production iOS/Android apps, pub.dev packages, founder-led delivery."
>
  <!-- TODO: Generate new OG image (1200x630) with headshot + name/title text for stronger branded SERP/chat previews.
       Source headshot exists but needs composite generation. Current og/default.png is valid fallback. -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <JourneyTrail />
  <Hero />
  <Approach />
  <FeaturedProjects />
  <SelectedWork n={2} label="From the archive" limit={4} viewAllHref={withBase('/projects')} viewAllCount={showcaseProjects.length} />
  <OssGrid />
  <ExperienceTimeline />
  <StackGrid />
  <HireMe />
</BaseLayout>
