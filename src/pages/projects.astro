---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SelectedWork from '@/components/sections/SelectedWork.astro';
import { withBase } from '@/lib/paths';
import { profile } from '@/data/profile';
import { showcaseProjects } from '@/data/showcase';

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'http://localhost:4321';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Projects — ${profile.name}`,
  url: `${siteUrl}/projects`,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: showcaseProjects.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'SoftwareApplication',
        name: p.name,
        description: p.tagline,
        applicationCategory: p.category,
        operatingSystem: p.web ? 'Web' : 'Android',
        author: { '@type': 'Person', name: profile.name },
        ...(p.storeLink || p.liveLink || p.githubLink
          ? { url: p.storeLink ?? p.liveLink ?? p.githubLink }
          : {}),
      },
    })),
  },
};
---
<BaseLayout
  title={`Projects — ${profile.name}`}
  description={`Selected work by ${profile.name} (${profile.alias}). 50+ apps shipped — streaming, rewards, downloaders, health, logistics and more. Tap any project for its full screenshot gallery.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <header class="page-head">
    <div class="container">
      <p class="crumb"><a href={withBase('/')}>~</a> / <span>projects</span></p>
      <h1 class="h1">Projects</h1>
      <p class="lead">
        Every app worth showing — client and personal, flagship and archive — each with its full
        screenshot gallery. Filter by category, tap any card to dive in. Built across {profile.basedIn} and remote teams worldwide.
      </p>
    </div>
  </header>

  <SelectedWork n={1} includeFeatured />

  <div class="container">
    <p class="back"><a href={withBase('/')}>← back home</a></p>
  </div>
</BaseLayout>

<style>
  .page-head { padding-block: clamp(var(--s-7), 7vw, var(--s-9)) 0; }
  .crumb { color: var(--fg-dim); font: 400 var(--fs-micro) var(--font-mono); letter-spacing: 0.1em; margin: 0 0 var(--s-5); }
  .crumb a { color: var(--accent); text-decoration: none; }
  .crumb a:hover { text-decoration: underline; }
  .h1 { margin: 0; color: var(--fg); font: 700 var(--fs-hero) / var(--lh-tight) var(--font-mono); letter-spacing: -0.02em; }
  .lead { margin: var(--s-4) 0 0; max-inline-size: 60ch; color: var(--fg-dim); font: 400 var(--fs-body) var(--font-sans); line-height: var(--lh-default); }
  .back { padding-block: var(--s-7) var(--s-9); margin: 0; }
  .back a { color: var(--accent); text-decoration: none; font: 600 var(--fs-small) var(--font-sans); }
  .back a:hover { text-decoration: underline; }
</style>
