---
import BaseLayout from '@/layouts/BaseLayout.astro';
import StatsRow from '@/components/atoms/StatsRow.astro';
import { withBase } from '@/lib/paths';
import { showcaseProjects } from '@/data/showcase';

interface Props {
  title: string;
  slug: string;
  tagline: string;
  stack: string[];
  stats: { num: string; unit?: string; desc: string }[];
  liveUrl?: string;
  sourceUrl?: string;
}
const { title, slug, tagline, stack, stats, liveUrl, sourceUrl } = Astro.props;

// Screenshot gallery — sourced from the matching showcase entry so case
// studies stay in sync with the project data without repeating file lists.
const proj = showcaseProjects.find((p) => p.slug === slug);
const screens = proj?.screens ?? [];
const isWide = (s: string) => !!proj?.web || /desktop|landscape|wide/.test(s);
---
<BaseLayout title={`${title} — case study`} description={tagline}>
  <div class="progress" aria-hidden="true"></div>
  <article class="container">
    <p class="crumb">
      <a href={withBase('/')}>~</a> / <a href={withBase('/projects')}>projects</a> / <span>{slug}</span>
    </p>

    <div class="layout">
      <header class="head">
        <h1 class="title" style={`view-transition-name: case-title-${slug};`}>{title}</h1>
        <p class="tagline">{tagline}</p>
      </header>

      {/* Meta rail — inline card on mobile/tablet, sticky sidebar on desktop */}
      <aside class="rail">
        <div class="rail-card">
          <p class="rail-k" aria-hidden="true">▸ Stack</p>
          <p class="stack">{stack.join(' · ')}</p>
          <div class="ctas">
            {liveUrl && <a class="cta primary" href={liveUrl} target="_blank" rel="noopener noreferrer">▶ Open live ↗</a>}
            {sourceUrl && <a class="cta secondary" href={sourceUrl} target="_blank" rel="noopener noreferrer">Source on GitHub →</a>}
          </div>
          <div class="rail-stats"><StatsRow stats={stats} compact /></div>
        </div>
      </aside>

      <div class="main">
        {screens.length > 0 && (
          <div class="shots" tabindex="0" aria-label={`${title} screenshots`}>
            {screens.map((s, i) => (
              <img
                src={withBase(`/screens/${s}`)}
                alt={`${title} screen ${i + 1}`}
                width={isWide(s) ? 1080 : 540}
                height={isWide(s) ? 692 : 1200}
                loading={i < 3 ? 'eager' : 'lazy'}
                decoding="async"
              />
            ))}
          </div>
        )}
        <div class="prose"><slot /></div>
        <p class="back"><a href={withBase('/projects')}>← back to projects</a></p>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .progress { position: fixed; inset-block-start: 0; inset-inline: 0; block-size: 3px; background: var(--accent); transform-origin: 0 50%; animation: progress linear both; animation-timeline: scroll(root block); animation-range: 0% 100%; animation-duration: 1ms; z-index: 100; }
  @keyframes progress { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @media (prefers-reduced-motion: reduce) { .progress { display: none; } }
  /* Mobile-first: single column; the meta rail renders as an inline card. */
  .container { padding-block: clamp(var(--s-7), 6vw, var(--s-9)); max-inline-size: 720px; }
  .crumb { color: var(--fg-dim); font: 400 var(--fs-micro) var(--font-mono); letter-spacing: 0.12em; }
  .crumb a { color: var(--accent); }
  .crumb span { color: var(--fg); }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-5); }
  .title { color: var(--fg); font: 700 clamp(2rem, 3vw + 0.5rem, 3rem) / var(--lh-tight) var(--font-sans); margin-block: var(--s-3) var(--s-2); }
  .tagline { color: var(--accent); font: 600 var(--fs-body) var(--font-sans); margin: 0; }
  .rail-card {
    display: grid; gap: var(--s-4);
    padding: var(--s-5);
    background: var(--bg-elev);
    border: 1px solid var(--border-soft);
    border-radius: var(--r-card);
  }
  .rail-k { margin: 0; color: var(--accent); font: 400 var(--fs-micro) var(--font-mono); letter-spacing: 0.18em; text-transform: uppercase; }
  .stack { color: var(--fg-dim); margin: 0; font: 400 var(--fs-small) var(--font-mono); }

  /* Tablet: wider page, roomier gallery, prose stays a readable measure. */
  @media (min-width: 768px) {
    .container { max-inline-size: 880px; }
  }

  /* Desktop: header spans; sticky meta rail beside the content column. */
  @media (min-width: 1024px) {
    .container { max-inline-size: 1140px; }
    .layout {
      grid-template-columns: minmax(0, 1fr) 260px;
      column-gap: var(--s-8);
      align-items: start;
    }
    .head { grid-column: 1 / -1; }
    .main { grid-column: 1; grid-row: 2; }
    .rail { grid-column: 2; grid-row: 2; }
    .rail-card { position: sticky; inset-block-start: var(--s-6); }
  }
  .ctas { display: flex; flex-wrap: wrap; gap: var(--s-3); }
  .cta { padding: var(--s-2) var(--s-4); border-radius: var(--r-pill); font: 600 var(--fs-small) var(--font-sans); text-decoration: none; min-block-size: 36px; display: inline-flex; align-items: center; }
  .primary { background: var(--accent); color: var(--bg); }
  .secondary { color: var(--accent); border: 1px solid var(--border-soft); }
  .primary:hover { background: color-mix(in oklab, var(--accent) 80%, white); color: var(--bg); }
  .secondary:hover { border-color: var(--accent); color: var(--fg); }
  /* Screenshot strip — fixed height, natural widths, horizontal scroll */
  .shots {
    display: flex; gap: var(--s-3);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    padding-block: var(--s-2) var(--s-3);
    margin-block: var(--s-6) var(--s-4);
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
    -webkit-overflow-scrolling: touch;
  }
  .shots:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: var(--r-pkg); }
  .shots img {
    flex: 0 0 auto;
    block-size: clamp(220px, 42svh, 280px);
    inline-size: auto;
    object-fit: contain;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-elev);
    scroll-snap-align: start;
  }
  .shots::-webkit-scrollbar { block-size: 8px; }
  .shots::-webkit-scrollbar-thumb { background: var(--border); border-radius: 99px; }
  /* Gallery grows with the viewport (kept after the base rule so it wins the cascade) */
  @media (min-width: 768px) { .shots img { block-size: clamp(280px, 38svh, 340px); } }
  @media (min-width: 1024px) { .shots img { block-size: clamp(360px, 48svh, 500px); } }

  .prose { font-family: var(--font-sans); font-size: var(--fs-prose); line-height: var(--lh-prose); color: var(--fg-dim); max-inline-size: 68ch; }
  .prose :global(h2) { color: var(--fg); font: 700 var(--fs-section) var(--font-sans); margin: var(--s-7) 0 var(--s-3); }
  .prose :global(h3) { color: var(--fg); font: 700 var(--fs-h3) var(--font-sans); margin: var(--s-6) 0 var(--s-3); }
  .prose :global(p) { margin: 0 0 var(--s-4); }
  .prose :global(ul) { margin: 0 0 var(--s-4); padding-inline-start: var(--s-5); }
  .prose :global(li) { margin-block-end: var(--s-2); }
  .prose :global(strong) { color: var(--fg); font-weight: 600; }
  .prose :global(code) { background: var(--bg-elev); color: var(--accent); padding: 2px 6px; border-radius: 4px; font: 400 0.9em var(--font-mono); }
  .prose :global(iframe) { inline-size: 100%; aspect-ratio: 16 / 9; border: 1px solid var(--border-soft); border-radius: var(--r-featured); margin-block: var(--s-5); }
  .back { margin-block-start: var(--s-8); font: 600 var(--fs-small) var(--font-mono); }
  .back a { color: var(--accent); }
</style>
